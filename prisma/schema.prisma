generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  TRAINER
  STUDENT
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  CAPTURED
  FAILED
  REFUNDED
}

enum EnrollmentSource {
  ONLINE_PAYMENT
  ADMIN_MANUAL
}

enum EnrollmentStatus {
  ACTIVE
  SUSPENDED
  EXPIRED
}

enum GalleryStatus {
  PENDING
  APPROVED
  REJECTED
}

enum BusinessGuidanceType {
  RECORDING
  PDF
  DOCUMENT
  TEXT
  MEETING_LINK
  SCHEDULED_SESSION
}

enum BlogStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  ARCHIVED
}

enum DiscountType {
  PERCENTAGE
  FLAT
}

enum TrainerRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// =============================================================================
// MODELS
// =============================================================================

model User {
  id                     String    @id @default(uuid())
  name                   String?
  phone                  String?   @unique
  email                  String?   @unique
  passwordHash           String    @map("password_hash")
  googleId               String?   @unique @map("google_id")
  role                   UserRole  @default(STUDENT)
  isActive               Boolean   @default(true) @map("is_active")
  refreshTokenHash       String?   @map("refresh_token_hash")
  resetPasswordToken     String?   @map("reset_password_token")
  resetPasswordExpiresAt DateTime? @map("reset_password_expires_at")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  studentProfile          StudentProfile?
  trainerProfile          TrainerProfile?
  coursesTaught           Course[]             @relation("TrainerCourses")
  orders                  Order[]
  payments                Payment[]
  enrollments             Enrollment[]
  progress                Progress[]
  certificates            Certificate[]
  gallerySubmissions      GallerySubmission[]  @relation("StudentGallerySubmissions")
  moderatedGallery        GallerySubmission[]  @relation("ModeratedGallerySubmissions")
  businessGuidance        BusinessGuidance[]
  blogs                   Blog[]
  reviews                 Review[]
  notifications           Notification[]
  trainerRequests         TrainerRequest[]     @relation("ApplicantTrainerRequests")
  reviewedTrainerRequests TrainerRequest[]     @relation("ReviewedTrainerRequests")
  couponUsages            CouponUsage[]

  @@map("users")
}

model StudentProfile {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  name      String
  phone     String?
  avatarUrl String?  @map("avatar_url")
  bio       String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("student_profiles")
}

model TrainerProfile {
  id          String   @id @default(uuid())
  userId      String   @unique @map("user_id")
  name        String
  phone       String?
  avatarUrl   String?  @map("avatar_url")
  bio         String?
  expertise   String?
  designation String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("trainer_profiles")
}

model Category {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String?
  imageUrl    String?  @map("image_url")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  courses Course[]

  @@map("categories")
}

model Course {
  id              String   @id @default(uuid())
  categoryId      String?  @map("category_id")
  trainerId       String?  @map("trainer_id")
  title           String
  slug            String   @unique
  description     String
  price           Decimal  @db.Decimal(10, 2)
  discountedPrice Decimal? @map("discounted_price") @db.Decimal(10, 2)
  thumbnailUrl    String?  @map("thumbnail_url")
  isPublished     Boolean  @default(false) @map("is_published")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  category           Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  trainer            User?               @relation("TrainerCourses", fields: [trainerId], references: [id], onDelete: SetNull)
  modules            CourseModule[]
  procedures         Procedure[]
  resources          Resource[]
  orders             Order[]
  enrollments        Enrollment[]
  progress           Progress[]
  certificates       Certificate[]
  gallerySubmissions GallerySubmission[]
  businessGuidance   BusinessGuidance[]
  reviews            Review[]
  coupons            Coupon[]

  @@map("courses")
}

model CourseModule {
  id          String   @id @default(uuid())
  courseId    String   @map("course_id")
  title       String
  description String?
  orderIndex  Int      @default(1) @map("order_index")
  isPublished Boolean  @default(true) @map("is_published")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  course           Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons          Lesson[]
  businessGuidance BusinessGuidance[]

  @@unique([courseId, orderIndex])
  @@map("course_modules")
}

model Lesson {
  id              String   @id @default(uuid())
  moduleId        String   @map("module_id")
  title           String
  description     String?
  videoProvider   String   @default("CLOUDINARY") @map("video_provider")
  videoId         String   @map("video_id")
  videoUrl        String   @map("video_url")
  thumbnailUrl    String?  @map("thumbnail_url")
  durationSeconds Int      @default(0) @map("duration_seconds")
  fileSizeBytes   BigInt?  @default(0) @map("file_size_bytes")
  orderIndex      Int      @default(1) @map("order_index")
  isPreview       Boolean  @default(false) @map("is_preview")
  isPublished     Boolean  @default(true) @map("is_published")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  module     CourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  procedures Procedure[]
  resources  Resource[]
  progress   Progress[]

  @@unique([moduleId, orderIndex])
  @@map("lessons")
}

model Procedure {
  id          String   @id @default(uuid())
  lessonId    String?  @map("lesson_id")
  courseId    String   @map("course_id")
  title       String
  contentText String   @map("content_text")
  orderIndex  Int      @default(1) @map("order_index")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  lesson    Lesson?    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  course    Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  resources Resource[]

  @@map("procedures")
}

model Resource {
  id          String   @id @default(uuid())
  courseId    String   @map("course_id")
  lessonId    String?  @map("lesson_id")
  procedureId String?  @map("procedure_id")
  title       String
  fileUrl     String   @map("file_url")
  fileType    String   @map("file_type")
  fileSize    BigInt?  @default(0) @map("file_size")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  course    Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lesson    Lesson?    @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  procedure Procedure? @relation(fields: [procedureId], references: [id], onDelete: SetNull)

  @@map("resources")
}

model Order {
  id                String      @id @default(uuid())
  studentId         String      @map("student_id")
  courseId          String      @map("course_id")
  orderNumber       String      @unique @map("order_number")
  amount            Decimal     @db.Decimal(10, 2)
  currency          String      @default("INR")
  status            OrderStatus @default(PENDING)
  razorpayOrderId   String?     @unique @map("razorpay_order_id")
  appliedCouponCode String?     @map("applied_coupon_code")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  student      User          @relation(fields: [studentId], references: [id], onDelete: Restrict)
  course       Course        @relation(fields: [courseId], references: [id], onDelete: Restrict)
  payment      Payment?
  enrollment   Enrollment?
  couponUsages CouponUsage[]

  @@map("orders")
}

model Payment {
  id                String        @id @default(uuid())
  orderId           String        @unique @map("order_id")
  studentId         String        @map("student_id")
  razorpayPaymentId String        @unique @map("razorpay_payment_id")
  razorpaySignature String        @map("razorpay_signature")
  amount            Decimal       @db.Decimal(10, 2)
  status            PaymentStatus @default(CAPTURED)
  paymentMethod     String?       @map("payment_method")
  rawPayload        Json?         @map("raw_payload")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  order   Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  student User  @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@map("payments")
}

model Enrollment {
  id         String           @id @default(uuid())
  studentId  String           @map("student_id")
  courseId   String           @map("course_id")
  orderId    String?          @unique @map("order_id")
  source     EnrollmentSource @default(ONLINE_PAYMENT)
  status     EnrollmentStatus @default(ACTIVE)
  enrolledAt DateTime         @default(now()) @map("enrolled_at")
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")

  student User   @relation(fields: [studentId], references: [id], onDelete: Restrict)
  course  Course @relation(fields: [courseId], references: [id], onDelete: Restrict)
  order   Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@unique([studentId, courseId])
  @@map("enrollments")
}

model Progress {
  id             String    @id @default(uuid())
  studentId      String    @map("student_id")
  courseId       String    @map("course_id")
  lessonId       String    @map("lesson_id")
  isCompleted    Boolean   @default(false) @map("is_completed")
  watchedSeconds Int       @default(0) @map("watched_seconds")
  completedAt    DateTime? @map("completed_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  student User   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course  Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lesson  Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([studentId, lessonId])
  @@map("progress")
}

model GallerySubmission {
  id              String        @id @default(uuid())
  studentId       String        @map("student_id")
  courseId        String        @map("course_id")
  title           String
  description     String?
  mediaUrl        String        @map("media_url")
  mediaType       String        @default("IMAGE") @map("media_type")
  status          GalleryStatus @default(PENDING)
  isFeatured      Boolean       @default(false) @map("is_featured")
  adminFeedback   String?       @map("admin_feedback")
  trainerFeedback String?       @map("trainer_feedback")
  moderatedBy     String?       @map("moderated_by")
  moderatedAt     DateTime?     @map("moderated_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  student   User   @relation("StudentGallerySubmissions", fields: [studentId], references: [id], onDelete: Cascade)
  course    Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  moderator User?  @relation("ModeratedGallerySubmissions", fields: [moderatedBy], references: [id], onDelete: SetNull)

  @@map("gallery_submissions")
}

model BusinessGuidance {
  id          String               @id @default(uuid())
  courseId    String?              @map("course_id")
  trainerId   String?              @map("trainer_id")
  moduleId    String?              @map("module_id")
  title       String
  contentType BusinessGuidanceType @default(RECORDING) @map("content_type")
  description String?
  resourceUrl String?              @map("resource_url")
  meetingTime DateTime?            @map("meeting_time")
  orderIndex  Int                  @default(1) @map("order_index")
  isPublished Boolean              @default(true) @map("is_published")
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")

  course  Course?       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  trainer User?         @relation(fields: [trainerId], references: [id], onDelete: SetNull)
  module  CourseModule? @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@map("business_guidance")
}

model BlogCategory {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  blogs Blog[]

  @@map("blog_categories")
}

model Blog {
  id               String     @id @default(uuid())
  authorId         String     @map("author_id")
  categoryId       String?    @map("category_id")
  title            String
  slug             String     @unique
  content          String
  featuredImageUrl String?    @map("featured_image_url")
  tags             String[]
  seoTitle         String?    @map("seo_title")
  seoDescription   String?    @map("seo_description")
  status           BlogStatus @default(DRAFT)
  publishedAt      DateTime?  @map("published_at")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  author   User          @relation(fields: [authorId], references: [id], onDelete: Restrict)
  category BlogCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@map("blogs")
}

model Review {
  id          String   @id @default(uuid())
  studentId   String   @map("student_id")
  courseId    String   @map("course_id")
  rating      Int
  comment     String?
  isPublished Boolean  @default(true) @map("is_published")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  student User   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course  Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId])
  @@map("reviews")
}

model Notification {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  title     String
  message   String
  type      String    @default("SYSTEM")
  isRead    Boolean   @default(false) @map("is_read")
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model SystemSetting {
  id           String   @id @default(uuid())
  settingKey   String   @unique @map("setting_key")
  settingValue String   @map("setting_value")
  description  String?
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

model Certificate {
  id                String   @id @default(uuid())
  studentId         String   @map("student_id")
  courseId          String   @map("course_id")
  certificateNumber String   @unique @map("certificate_number")
  verificationCode  String   @unique @map("verification_code")
  issueDate         DateTime @default(now()) @map("issue_date")
  pdfUrl            String?  @map("pdf_url")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  student User   @relation(fields: [studentId], references: [id], onDelete: Restrict)
  course  Course @relation(fields: [courseId], references: [id], onDelete: Restrict)

  @@unique([studentId, courseId])
  @@map("certificates")
}

model Coupon {
  id                String       @id @default(uuid())
  code              String       @unique
  description       String?
  discountType      DiscountType @default(PERCENTAGE) @map("discount_type")
  discountValue     Decimal      @map("discount_value") @db.Decimal(10, 2)
  minOrderAmount    Decimal?     @default(0) @map("min_order_amount") @db.Decimal(10, 2)
  maxDiscountAmount Decimal?     @map("max_discount_amount") @db.Decimal(10, 2)
  startDate         DateTime?    @default(now()) @map("start_date")
  expiryDate        DateTime?    @map("expiry_date")
  usageLimit        Int?         @map("usage_limit")
  usageCount        Int          @default(0) @map("usage_count")
  perUserLimit      Int          @default(1) @map("per_user_limit")
  courseId          String?      @map("course_id")
  isActive          Boolean      @default(true) @map("is_active")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  course Course?       @relation(fields: [courseId], references: [id], onDelete: SetNull)
  usages CouponUsage[]

  @@map("coupons")
}

model CouponUsage {
  id             String   @id @default(uuid())
  couponId       String   @map("coupon_id")
  userId         String   @map("user_id")
  orderId        String?  @map("order_id")
  discountAmount Decimal  @map("discount_amount") @db.Decimal(10, 2)
  usedAt         DateTime @default(now()) @map("used_at")

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  order  Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@map("coupon_usages")
}

model TrainerRequest {
  id               String               @id @default(uuid())
  userId           String?              @map("user_id")
  name             String
  phone            String
  email            String?
  expertise        String
  experienceYears  Int?                 @map("experience_years")
  proposedSchedule String?              @map("proposed_schedule")
  bio              String?
  portfolioUrl     String?              @map("portfolio_url")
  sampleVideoUrl   String?              @map("sample_video_url")
  resumeUrl        String?              @map("resume_url")
  status           TrainerRequestStatus @default(PENDING)
  adminNotes       String?              @map("admin_notes")
  reviewedBy       String?              @map("reviewed_by")
  reviewedAt       DateTime?            @map("reviewed_at")
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")

  user     User? @relation("ApplicantTrainerRequests", fields: [userId], references: [id], onDelete: SetNull)
  reviewer User? @relation("ReviewedTrainerRequests", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@map("trainer_requests")
}

model CarouselSlide {
  id          String   @id @default(uuid())
  title       String
  tagline     String?
  description String?  @db.Text
  imageUrl    String   @map("image_url")
  route       String?  @default("/courses")
  category    String?
  order       Int      @default(0)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("carousel_slides")
}
